<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BRAND -->

    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="#2563EB" />

    <SolidColorBrush
        x:Key="PrimaryHoverBrush"
        Color="#1D4ED8" />

    <SolidColorBrush
        x:Key="PrimarySoftBrush"
        Color="#EFF6FF" />


    <!-- BACKGROUNDS -->

    <SolidColorBrush
        x:Key="BackgroundBrush"
        Color="#F6F7F9" />

    <SolidColorBrush
        x:Key="SurfaceBrush"
        Color="#FFFFFF" />

    <SolidColorBrush
        x:Key="NavigationBrush"
        Color="#FFFFFF" />

    <!-- Mantido para a tela de Login -->

    <SolidColorBrush
        x:Key="SidebarBrush"
        Color="#101828" />

    <SolidColorBrush
        x:Key="SidebarHoverBrush"
        Color="#1D2939" />


    <!-- TEXT -->

    <SolidColorBrush
        x:Key="TextPrimaryBrush"
        Color="#101828" />

    <SolidColorBrush
        x:Key="TextSecondaryBrush"
        Color="#667085" />

    <SolidColorBrush
        x:Key="TextMutedBrush"
        Color="#98A2B3" />

    <SolidColorBrush
        x:Key="IconBrush"
        Color="#475467" />


    <!-- STRUCTURE -->

    <SolidColorBrush
        x:Key="BorderBrush"
        Color="#E4E7EC" />

    <SolidColorBrush
        x:Key="DividerBrush"
        Color="#EAECF0" />


    <!-- FEEDBACK -->

    <SolidColorBrush
        x:Key="SuccessBrush"
        Color="#16A34A" />

    <SolidColorBrush
        x:Key="SuccessSoftBrush"
        Color="#F0FDF4" />

    <SolidColorBrush
        x:Key="WarningBrush"
        Color="#D97706" />

    <SolidColorBrush
        x:Key="WarningSoftBrush"
        Color="#FFFBEB" />

    <SolidColorBrush
        x:Key="DangerBrush"
        Color="#DC2626" />

    <SolidColorBrush
        x:Key="DangerSoftBrush"
        Color="#FEF2F2" />

    <SolidColorBrush
        x:Key="InfoBrush"
        Color="#0284C7" />

    <SolidColorBrush
        x:Key="InfoSoftBrush"
        Color="#F0F9FF" />

</ResourceDictionary>