<Window
    x:Class="LMSys.Market.Desktop.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:LMSys.Market.Desktop.Behaviors"
    Title="LMSys Market"
    Width="1080"
    Height="680"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    Background="{StaticResource SurfaceBrush}">

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition
                Width="1.05*" />

            <ColumnDefinition
                Width="*" />

        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}">

            <Grid
                Margin="64">

                <Grid.RowDefinitions>

                    <RowDefinition
                        Height="Auto" />

                    <RowDefinition
                        Height="*" />

                    <RowDefinition
                        Height="Auto" />

                </Grid.RowDefinitions>

                <StackPanel>

                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="14">

                        <TextBlock
                            Text="LM"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="20"
                            FontWeight="Bold" />

                    </Border>

                    <TextBlock
                        Margin="0,22,0,0"
                        Text="LMSys Market"
                        Foreground="White"
                        FontSize="30"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Gestão profissional para supermercados"
                        Foreground="#98A2B3"
                        FontSize="15" />

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Sua operação&#x0a;sob controle."
                        Foreground="White"
                        FontSize="42"
                        FontWeight="SemiBold"
                        LineHeight="50" />

                    <TextBlock
                        Margin="0,24,60,0"
                        Text="Produtos, estoque, compras, PDV, caixa e gestão em uma única plataforma."
                        Foreground="#98A2B3"
                        FontSize="16"
                        TextWrapping="Wrap"
                        LineHeight="26" />

                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Text="LMSys • Business Software"
                    Foreground="#667085"
                    FontSize="12" />

            </Grid>

        </Border>

        <Grid
            Grid.Column="1"
            Margin="72,50">

            <StackPanel
                Width="350"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    Text="Bem-vindo"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="30"
                    FontWeight="SemiBold" />

                <TextBlock
                    Margin="0,8,0,34"
                    Text="Entre com suas credenciais para continuar."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="14" />

                <TextBlock
                    Text="Usuário ou e-mail"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="13"
                    FontWeight="SemiBold" />

                <TextBox
                    Margin="0,8,0,20"
                    Style="{StaticResource InputTextBoxStyle}"
                    Text="{Binding Identifier,
                                   UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Text="Senha"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="13"
                    FontWeight="SemiBold" />

                <PasswordBox
                    Margin="0,8,0,0"
                    Style="{StaticResource InputPasswordBoxStyle}"
                    behaviors:PasswordBoxBehavior.IsEnabled="True"
                    behaviors:PasswordBoxBehavior.Password="{Binding Password,
                                   Mode=TwoWay,
                                   UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,10,0,0"
                    MinHeight="20"
                    Text="{Binding ErrorMessage}"
                    Foreground="{StaticResource DangerBrush}"
                    FontSize="12"
                    TextWrapping="Wrap" />

                <Button
                    Margin="0,18,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding LoginCommand}"
                    Content="{Binding LoginButtonText}"
                    IsDefault="True" />

                <TextBlock
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    Text="LMSys Market • v0.1.0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11" />

            </StackPanel>

        </Grid>

    </Grid>

</Window>